{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "npm run build && wrangler dev --local --var BOOTSTRAP_ADMIN_EMAIL:local-admin@viendong.test",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm run check:encoding",
    "check:encoding": "node scripts/check-encoding.mjs",
    "preview": "vite preview",
    "format": "oxfmt",
    "r2:migrate": "node scripts/migrate-public-media-to-r2.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "jose": "^6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.4",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
