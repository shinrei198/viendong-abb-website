{
  "name": "viendong-abb-website",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-01",
  "access": {
    "dev": {
      "aud": "local-viendong-admin",
      "identity": {
        "email": "local-admin@viendong.test",
        "name": "Local Admin"
      }
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "VIENDONG_KV",
      "id": "81f19f5af04f4cd1994f8e3b6db01cb9"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "viendong-quotes",
      "database_id": "c8c1449e-42bd-4894-a1f8-56c22dc2499e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "viendong-media"
    }
  ],
  "cache": {
    "enabled": true
  }
}
